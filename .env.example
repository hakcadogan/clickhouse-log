# Copy this file to .env, then replace the example passwords before starting.
# Turkey Time (UTC+3)
TZ=Europe/Istanbul

# ClickHouse
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=change-this-clickhouse-password
CLICKHOUSE_DB=sys_logs
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9008
CLICKHOUSE_INTERSERVER_PORT=9009

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
GRAFANA_PORT=3002

# Tabix
TABIX_PORT=8080
